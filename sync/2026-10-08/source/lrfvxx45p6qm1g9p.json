%22mode%22%3A%22json%22%2C%22code%22%3A%22%5B%5Cn%20%20%7B%5C%22id%5C%22%3A%5C%22n1%5C%22%2C%5C%22tool%5C%22%3A%5C%22search_web%5C%22%2C%5C%22race_group%5C%22%3A%5C%22search%5C%22%2C%5C%22depends_on%5C%22%3A%5B%5D%7D%2C%5Cn%20%20%7B%5C%22id%5C%22%3A%5C%22n2%5C%22%2C%5C%22tool%5C%22%3A%5C%22rag_search%5C%22%2C%5C%22race_group%5C%22%3A%5C%22search%5C%22%2C%5C%22depends_on%5C%22%3A%5B%5D%7D%5Cn%5D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22id%22%3A%22X6vy7%22%7D\"></card><p data-lake-id=\"uf4d6b520\" id=\"uf4d6b520\"><strong><span data-lake-id=\"u810f605f\" id=\"u810f605f\">调度细节</span></strong><span data-lake-id=\"u3a910bdf\" id=\"u3a910bdf\">：</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22go%22%2C%22code%22%3A%22ch%20%3A%3D%20make(chan%20raceResult%2C%20len(g.NodeIDs))%5CnraceCtx%2C%20cancel%20%3A%3D%20context.WithCancel(ctx)%5Cn%5Cnfor%20_%2C%20nodeID%20%3A%3D%20range%20g.NodeIDs%20%7B%5Cn%20%20%20%20go%20func(id%20graph.NodeID)%20%7B%5Cn%20%20%20%20%20%20%20%20res%2C%20err%20%3A%3D%20rt.executeSingleNode(raceCtx%2C%20id)%5Cn%20%20%20%20%20%20%20%20ch%20%3C-%20raceResult%7BnodeID%3A%20id%2C%20result%3A%20res%2C%20err%3A%20err%7D%5Cn%20%20%20%20%7D(nodeID)%5Cn%7D%5Cn%5Cn%2F%2F%20%E9%A6%96%E4%B8%AA%E6%88%90%E5%8A%9F%20%E2%86%92%20%E5%8F%96%E6%B6%88%E5%85%B6%E4%BD%99%5CnwinnerFound%20%3A%3D%20false%5Cnfor%20i%20%3A%3D%200%3B%20i%20%3C%20len(g.NodeIDs)%3B%20i%2B%2B%20%7B%5Cn%20%20%20%20r%20%3A%3D%20%3C-ch%5Cn%20%20%20%20if%20r.err%20%3D%3D%20nil%20%26%26%20!winnerFound%20%7B%5Cn%20%20%20%20%20%20%20%20winnerFound%20%3D%20true%5Cn%20%20%20%20%20%20%20%20cancel()%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%20%2F%2F%20%E5%85%B3%E9%94%AE%EF%BC%9A%E5%8F%96%E6%B6%88%E5%85%B6%E4%BD%99%5Cn%20%20%20%20%20%20%20%20rt.results%5Br.nodeID%5D%20%3D%20r.result%5Cn%20%20%20%20%20%20%20%20rt.graph.SetNodeStatus(r.nodeID%2C%20graph.StatusDone)%5Cn%20%20%20%20%7D%5Cn%7D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22id%22%3A%22OhFtx%22%7D\"></card><p data-lake-id=\"u597ec52b\" id=\"u597ec52b\"><strong><span data-lake-id=\"uc75bb7a3\" id=\"uc75bb7a3\">好处</span></strong><span data-lake-id=\"ub7a4fae4\" id=\"ub7a4fae4\">：</span></p><ul list=\"uea169178\"><li fid=\"uf4d2de04\" data-lake-id=\"u408e83c5\" id=\"u408e83c5\"><strong><span data-lake-id=\"ud4345ae2\" id=\"ud4345ae2\">延迟降低</span></strong><span data-lake-id=\"uf0e5d23e\" id=\"uf0e5d23e\">：N 路并发，wall-clock = min(各路延迟)</span></li><li fid=\"uf4d2de04\" data-lake-id=\"u79eefe09\" id=\"u79eefe09\"><strong><span data-lake-id=\"ua0ba38c9\" id=\"ua0ba38c9\">可靠性提升</span></strong><span data-lake-id=\"u71d43f07\" id=\"u71d43f07\">：单源故障不致命，其他源继续</span></li><li fid=\"uf4d2de04\" data-lake-id=\"ua4c8f0e0\" id=\"ua4c8f0e0\"><strong><span data-lake-id=\"ubce7a8f1\" id=\"ubce7a8f1\">Cypher 级语义</span></strong><span data-lake-id=\"u40fd32b2\" id=\"u40fd32b2\">：First-success-wins 比 LangGraph 的&quot;全等&quot;语义更适合 agent 场景</span></li></ul><p data-lake-id=\"u2346b299\" id=\"u2346b299\"><strong><span data-lake-id=\"ubdd94095\" id=\"ubdd94095\">例子</span></strong><span data-lake-id=\"ub2b79d52\" id=\"ub2b79d52\">：用户问&quot;研究 React 18 写一份报告并保存到知识库&quot;——Planner 生成：</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22plain%22%2C%22code%22%3A%22n1%20%5Bsub_agent%3A%20research_agent%5D%20%20%E2%86%90%20%E7%A0%94%E7%A9%B6%5Cnn2%20%5Bsub_agent%3A%20writer_agent%5D%20%20%20%20%E2%86%90%20%E5%86%99%E6%8A%A5%E5%91%8A%EF%BC%8Cdepends_on%3A%20%5Bn1%5D%5Cnn3%20%5Bsub_agent%3A%20review_agent%5D%20%20%20%20%E2%86%90%20%E5%AE%A1%E6%9F%A5%EF%BC%8Cdepends_on%3A%20%5Bn2%5D%5Cnn4%20%5Bsub_agent%3A%20doc_agent%5D%20%20%20%20%20%20%20%E2%86%90%20%E4%BF%9D%E5%AD%98%E5%88%B0%20RAG%EF%BC%8Cdepends_on%3A%20%5Bn2%2C%20n3%5D%22%2C%22autoWrap%22%3Afalse%2C%22lineNumbers%22%3Atrue%2C%22heightLimit%22%3Atrue%2C%22collapsed%22%3Afalse%2C%22hideToolbar%22%3Afalse%2C%22name%22%3A%22%22%2C%22tabSize%22%3Anull%2C%22indentWithTab%22%3Afalse%2C%22lightLines%22%3A%5B%5D%2C%22foldLines%22%3A%5B%5D%2C%22theme%22%3A%22default%22%2C%22id%22%3A%22tl0JZ%22%7D\"></card><h3 data-lake-id=\"tyhhP\" id=\"tyhhP\"><span data-lake-id=\"u36103f9f\" id=\"u36103f9f\">2.3 拓扑分层 vs 单步推进</span></h3><p data-lake-id=\"ua0dc0bb0\" id=\"ua0dc0bb0\"><strong><span data-lake-id=\"uf6a24818\" id=\"uf6a24818\">LangGraph</span></strong><span data-lake-id=\"u375f181a\" id=\"u375f181a\">：每次推进一个&quot;step&quot;，状态机驱动，需要 conditional edge 决定下一步。</span></p><ul list=\"ub4354a33\"><li fid=\"u8541bd00\" data-lake-id=\"u7e999487\" id=\"u7e999487\"><span data-lake-id=\"u9d7ffbb5\" id=\"u9d7ffbb5\">优点：可控性强、便于回放</span></li><li fid=\"u8541bd00\" data-lake-id=\"ub271feb1\" id=\"ub271feb1\"><span data-lake-id=\"uab5bae30\" id=\"uab5bae30\">缺点：并发需要手动 Send，复杂度上来</span></li></ul><p data-lake-id=\"ub01447c3\" id=\"ub01447c3\"><strong><span data-lake-id=\"u5fe93696\" id=\"u5fe93696\">本项目</span></strong><span data-lake-id=\"u5d809b3f\" id=\"u5d809b3f\">：Kahn 算法分层，</span><strong><span data-lake-id=\"u303c8ce6\" id=\"u303c8ce6\">同层自动并行</span></strong><span data-lake-id=\"u9e98ab14\" id=\"u9e98ab14\">。</span></p><card type=\"inline\" name=\"codeblock\" value=\"data:%7B%22search%22%3A%22%22%2C%22mode%22%3A%22go%22%2C%22code%22%3A%22levels%5B0%5D%20%3D%20%5Bn1%2C%20n2%5D%20%20%20%20%2F%2F%20%E5%85%A5%E5%BA%A6%3D0%EF%BC%8C%E5%8F%AF%E7%AB%8B%E5%8D%B3%E6%89%A7%E8%A1%8C%5Cnlevels%5B1%5D%20%3D%20%5B